# Copy to .env — never commit .env. Loaded by python-dotenv in src/runner/cli.py.

# --- Providers (Phase 3) ---
# SerpAPI: Google Flights results + the "typical price" band used as the external benchmark.
SERPAPI_KEY=
# Amadeus Self-Service: second price source with branded-fare detail.
# Use the TEST host while developing; test-env prices are fake and MUST NOT be stored as observations.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOST=test    # test | production

# --- Budget (Phase 2 circuit breaker) ---
# Set from the plan you actually pay for. 100 searches/month on SerpAPI's free tier
# ≈ 3/day; two watchlists polled 2x/day is already 4.
MAX_DAILY_API_CALLS=4
MAX_CALLS_PER_RUN=3

# --- Alerts (Phase 6) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Storage ---
# Local SQLite by default. Set a libsql:// URL (Turso) only if the dashboard must run off-host.
FARES_DB_PATH=data/fares.db
