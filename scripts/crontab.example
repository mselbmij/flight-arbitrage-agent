# fare tracker -- install with `crontab -e` after `fares alert-test` has reached your phone.
# ARCHITECTURE.md section 7. Paths assume the checkout lives in /opt/flight-arbitrage-agent
# (scripts/install.sh prints this file with your real path filled in). Times are host-local.
PATH=/usr/local/bin:/usr/bin:/bin

# polls at 06:50 and 17:20 plus 0-8 min of jitter (awk, so it works under dash/sh as well as bash)
50 6,17 * * *  sleep $(awk 'BEGIN{srand(); print int(rand()*540)}'); cd /opt/flight-arbitrage-agent && .venv/bin/fares poll --trigger cron >> ops/poll.log 2>&1

# nightly online backup, newest 14 kept
0 3 * * *  /opt/flight-arbitrage-agent/scripts/backup_db.sh >> /opt/flight-arbitrage-agent/ops/backup.log 2>&1

# watchdog: pings the phone (and exits 1) if no run has started in 36h
0 9,21 * * *  cd /opt/flight-arbitrage-agent && .venv/bin/fares health >> ops/health.log 2>&1
